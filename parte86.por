programa {
  funcao inicio() {
                escreva("
  Escolha a forma de pagamento: ")
                leia(opcao_pagamento)
                {
                   caso 1:
                      valor_desconto = valor_total_bruto * 0.10
                      valor_final = 0.0
                      pare
                   caso 2:
                      valor_desconto = 0.0
                      valor_final = valor_total_bruto
                      pare
                   caso contratio:
                      escreva("
  opção inválida! Processando valor normal.
  }
}
